# RadCode Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# LLM API Keys (Required for task execution)
# ============================================

# Free models (get your own keys from respective providers)
GEMINI_API_KEY=your_gemini_api_key
ZAI_API_KEY=your_zai_api_key
NVIDIA_API_KEY=your_nvidia_api_key

# Other free keys
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
SERPER_API_KEY=your_serper_api_key

# Model selection (default: groq/llama-3.1-70b-instruct)
LLM_MODEL=groq/llama-3.1-70b-instruct

# ============================================
# Security (Optional)
# ============================================
RADCODE_SECURITY=medium
RADCODE_TIMEOUT=600

# ============================================
# Server (Optional)
# ============================================
PORT=8000

# API key for admin endpoints (optional)
# RADCODE_API_KEY=your-secret-key-here

# ============================================
# Workspace (Optional)
# ============================================
RADCODE_WORKSPACES=/workspace
