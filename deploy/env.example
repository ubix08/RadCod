# RadCode Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# LLM Configuration (Required)
# ============================================

# Choose ONE provider:

# OpenAI (recommended)
# OPENAI_API_KEY=sk-...

# Anthropic Claude
# LLM_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=...

# Model selection
LLM_MODEL=anthropic/claude-sonnet-4-5-20250929

# ============================================
# Security (Optional)
# ============================================

# Security level: low, medium, high
RADCODE_SECURITY=medium

# Task timeout in seconds
RADCODE_TIMEOUT=600

# ============================================
# Server (Optional)
# ============================================

# Server port (default: 8000)
# PORT=8000

# API key for admin endpoints (optional)
# RADCODE_API_KEY=your-secret-key-here

# ============================================
# Workspace (Optional)
# ============================================

# Custom workspace directory
# RADCODE_WORKSPACES=/workspace